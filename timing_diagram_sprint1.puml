@startuml
actor User
participant "CLI (click)" as CLI
participant "import_data_from_source" as Importer
participant "DataLoadingService" as Loader
participant "DataCleaner" as Cleaner
participant "DataStorageService" as Storage
participant "SQLiteRepository" as Repo
database "SQLite DB" as DB

User -> CLI : import
CLI -> Importer : import_data_from_source()

Importer -> Loader : load_data()
Loader --> Importer : raw rows

Importer -> Cleaner : clean(rows)
Cleaner --> Importer : cleaned rows

Importer -> Storage : connect()
Storage -> Repo : connect()
Repo -> DB : OPEN CONNECTION

Importer -> Storage : save_full_record()
Storage -> Repo : create_tables()
Repo -> DB : CREATE TABLE

Storage -> Repo : save_records()
Repo -> DB : INSERT RECORDS

Importer -> Storage : disconnect()
Storage -> Repo : disconnect()
Repo -> DB : CLOSE CONNECTION

CLI --> User : [DONE] Data import completed

@enduml